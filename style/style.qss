/* Grafica sfondo main */
QMainWindow {
    background-color: #202020;
}

QWidget {
    background-color: #202020;
}

QStackedWidget {
    background-color: #202020;
}

QScrollArea {
    background-color: #202020;
    border: none;
}

/* bottoni ed aree */

QToolButton {
    background-color: #3b3a3a;
    color: white;
    border-radius: 24px;
    font-weight: bold;
}

QToolButton:hover {
    background-color: #444444;
}

QToolButton#bt_onl, QToolButton#bt_offl {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 15pt;
    padding: 20px;
}

QFrame#nav_bar {
    border-top: 0px;
    border-left: 0px;
    border-right: 0px;
    border-bottom: 1px solid #1f1f1f;

    background-color: #000000;
}

QFrame#nav_bar QPushButton {

    background-color: #070707;

    border: 1px solid #a8a8a8;
    border-radius: 6px;

    color: #ffffff;
    font-size: 14pt;
    font-weight: bold;
}

QFrame#nav_bar QPushButton:hover {
    background-color: #1a1a1a;
    border-radius: 6px;
}

QFrame#nav_bar QPushButton:disabled {
    color: #555555;
}


QPushButton#add_playlist {
    background-color: #3b3a3a;
    color: white;
    border: none;
    border-radius: 12px;
    text-align: left;
    padding-left: 24px;
    font-size: 18px;
    font-weight: bold;
}

QPushButton#playlist_bt {
    background-color: #292929;
    color: white;
    border: 1px solid #ff000000;
    border-radius: 12px;
    text-align: left;
    padding-left: 24px;
    font-size: 18px;
    font-weight: bold;
}

QPushButton#add_playlist:hover, QPushButton#playlist_bt:hover {
    background-color: #444444;
}

QFrame#side_menu {
    background-color: #1f1f1f;
    border: 1px solid #333333;
    border-radius: 20px;
}

QFrame#menu_box_bt {
    background-color: #2b2b2b;
    border-radius: 12px;
}

QLabel#side_title_bt {
    color: white;
    background-color: transparent;
    font-size: 12pt;
    font-weight: bold;
    padding: 6px 12px;
}

/*grafica dei pulsanti, quelli  per ordinare le cose, le playlist*/

QPushButton#bt_ordine {
    background-color: transparent;
    border: 1px solid #353535;
    color: #cccccc;
    border-radius: 6px;
    text-align: left;
    padding: 8px 12px;
    font-size: 11pt;
}

QPushButton#bt_ordine:hover {
    background-color: #3b3a3a;
    color: white;
}

QPushButton#bt_ordine:checked {
    background-color: #e6e6e6;
    color: #202020;
}

QPushButton#bt_ordine:disabled {
    color: #666666;
}