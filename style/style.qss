QToolButton {
    background-color: #3b3a3a;
    color: white;
    border-radius: 24px;
    font-weight: bold;
}

QToolButton:hover {
    background-color: #444444;
}

QToolButton#bt_onl, QToolButton#bt_offl {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 15pt;
    padding: 20px;
}

QFrame#nav_bar {
    border-top: 0px;
    border-left: 0px;
    border-right: 0px;
    border-bottom: 1px solid #1f1f1f;

    background-color: #000000;
}

QFrame#nav_bar QPushButton {

    background-color: #070707;

    border: 1px solid #a8a8a8;
    border-radius: 6px;

    color: #ffffff;
    font-size: 14pt;
    font-weight: bold;
}

QFrame#nav_bar QPushButton:hover {
    background-color: #1a1a1a;
    border-radius: 6px;
}

QFrame#nav_bar QPushButton:disabled {
    color: #555555;
}


QPushButton#add_playlist, QPushButton#playlist_bt {
    background-color: #3b3a3a;
    color: white;
    border: none;
    border-radius: 12px;
    text-align: left;
    padding-left: 24px;
    font-size: 18px;
    font-weight: bold;
}

QPushButton#add_playlist:hover, QPushButton#playlist_bt:hover {
    background-color: #444444;
}