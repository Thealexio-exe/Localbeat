QToolButton {
    background-color: #3b3a3a;
    color: white;
    border-radius: 24px;
    font-weight: bold;
}

QToolButton:hover {
    background-color: #444444;
}

QToolButton#bt_onl, QToolButton#bt_offl {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 20px;
    padding: 20px;
}

QFrame#nav_bar {
    border-top: 0px;
    border-left: 0px;
    border-right: 0px;
    border-bottom: 1px solid #1f1f1f;

    background-color:#000000;
}